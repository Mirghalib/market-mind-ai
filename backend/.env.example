# # --- Application ---
# APP_NAME=Market Mind AI
# APP_ENV=development
# APP_DEBUG=true
# APP_VERSION=0.1.0
# API_V1_STR=/api/v1
# SECRET_KEY=change-me-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# # --- Database (PostgreSQL) ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_mind_ai

# --- AI (LLM provider) ---
# Provider: "openai" or "anthropic". Model should match the provider.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# Read from environment variables: OPENAI_API_KEY for openai, ANTHROPIC_API_KEY for anthropic.
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1.0
AI_REQUEST_TIMEOUT_SECONDS=60.0
# Session-mode pooler URL used by Alembic migrations (Supabase).
# Falls back to DATABASE_URL when unset.
# DIRECT_URL=

# --- Logging ---
LOG_LEVEL=INFO

# --- Application ---
APP_NAME=Market Mind AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# --- Database (PostgreSQL) ---
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

# --- Logging ---
LOG_LEVEL=INFO

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
ANON_KEY=
SERVICE_ROLE_KEY=
host=
port=
database=
user=
