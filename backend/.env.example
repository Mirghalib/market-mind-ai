# --- Application ---
APP_NAME=Market Mind AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_STR=/api/v1

# --- Security ---
# CHANGE THIS before deploying anywhere public.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) ---
# Transaction-mode pooler URL used by the application (Supabase recommends this).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_mind_ai
# Session-mode pooler URL used by Alembic migrations (Supabase). Falls back to DATABASE_URL when unset.
DIRECT_URL=

# --- AI (LLM provider) ---
# Provider: "groq" (default), "openai" or "anthropic".
AI_PROVIDER=groq
# Groq Llama model.
AI_MODEL=llama-3.3-70b-versatile
# Provider API keys — only the one matching AI_PROVIDER is required.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1.0
AI_REQUEST_TIMEOUT_SECONDS=60.0
# Degrade to a deterministic mock strategy when the provider is rate-limited
# or unavailable. Set to false in production to surface real errors.
AI_FALLBACK_TO_MOCK=true

# --- Uploads ---
UPLOAD_DIR=uploads
PROFILE_IMAGE_DIR=uploads/profile_images
PUBLIC_BASE_URL=http://localhost:8000

# --- Email (SMTP) ---
# Used by the "Email Report" export action and user invitations.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true
# For Gmail use an App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
REPORT_FROM_NAME=Market Mind AI

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
