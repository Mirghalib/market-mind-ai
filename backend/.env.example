# --- Application ---
APP_NAME=Market Mind AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_mind_ai

# --- AI (LLM provider) ---
# Provider: "openai" or "anthropic". Model should match the provider.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# Read from environment variables: OPENAI_API_KEY for openai, ANTHROPIC_API_KEY for anthropic.
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1.0
AI_REQUEST_TIMEOUT_SECONDS=60.0

# --- Logging ---
LOG_LEVEL=INFO


