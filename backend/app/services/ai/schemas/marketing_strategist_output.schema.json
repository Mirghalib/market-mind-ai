{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marketmind.ai/schemas/marketing-strategist-output.json",
  "title": "AI Marketing Strategist Output",
  "description": "Structured output generated by the AI Marketing Strategist pipeline. Flat, sectioned layout designed for straightforward React rendering: each section is a top-level object, every array item carries an 'id' for React list keys, and fields expose title/description for labels and tooltips.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marketingStrategy",
    "customerPersona",
    "swotAnalysis",
    "seoKeywords",
    "contentCalendar",
    "advertisementIdeas",
    "emailCampaign",
    "competitorAnalysis",
    "recommendedTools"
  ],
  "properties": {
    "marketingStrategy": {
      "type": "object",
      "title": "Marketing Strategy",
      "description": "Overall go-to-market strategy, objectives, channels, budget split, and KPIs.",
      "additionalProperties": false,
      "required": ["overview", "objectives", "positioning", "keyMessages", "channels", "budgetAllocation", "kpis"],
      "properties": {
        "overview": {
          "type": "string",
          "description": "Short executive summary of the strategy."
        },
        "objectives": {
          "type": "array",
          "description": "Primary marketing objectives (e.g. 'Increase online sales by 20%').",
          "items": { "type": "string" }
        },
        "positioning": {
          "type": "string",
          "description": "How the brand should be positioned in the market."
        },
        "keyMessages": {
          "type": "array",
          "description": "Core messages that should appear across all channels.",
          "items": { "type": "string" }
        },
        "channels": {
          "type": "array",
          "description": "Recommended marketing channels ranked by priority.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "priority"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "name": { "type": "string", "description": "Channel name (e.g. Instagram, Email)." },
              "priority": { "type": "string", "enum": ["high", "medium", "low"], "description": "How important this channel is." },
              "description": { "type": "string", "description": "Why this channel and how to use it." }
            }
          }
        },
        "budgetAllocation": {
          "type": "array",
          "description": "How the budget is split across channels (percentages sum to 100).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "percentage"],
            "properties": {
              "channel": { "type": "string", "description": "Channel name." },
              "percentage": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Share of budget, 0-100." }
            }
          }
        },
        "kpis": {
          "type": "array",
          "description": "Success metrics with targets and timeframes.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "metric", "target"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "metric": { "type": "string", "description": "KPI name (e.g. Conversion rate)." },
              "target": { "type": "string", "description": "Target value (e.g. '3.5%')." },
              "timeframe": { "type": "string", "description": "When the target should be met (e.g. 'Q3')." }
            }
          }
        }
      }
    },

    "customerPersona": {
      "type": "object",
      "title": "Customer Persona",
      "description": "Detailed profile of the target customer.",
      "additionalProperties": false,
      "required": ["name", "ageRange", "location", "occupation", "incomeLevel", "summary", "interests", "painPoints", "goals", "preferredChannels", "buyingTriggers", "objections"],
      "properties": {
        "name": { "type": "string", "description": "Persona name (e.g. 'Startup Sam')." },
        "ageRange": { "type": "string", "description": "Age band (e.g. '28-40')." },
        "location": { "type": "string", "description": "Primary geographic location." },
        "occupation": { "type": "string", "description": "Job title or profession." },
        "incomeLevel": { "type": "string", "description": "Approximate income band." },
        "summary": { "type": "string", "description": "One-paragraph description of the persona." },
        "interests": { "type": "array", "description": "Hobbies and interests.", "items": { "type": "string" } },
        "painPoints": { "type": "array", "description": "Challenges and frustrations.", "items": { "type": "string" } },
        "goals": { "type": "array", "description": "What the persona wants to achieve.", "items": { "type": "string" } },
        "preferredChannels": { "type": "array", "description": "Channels the persona engages with most.", "items": { "type": "string" } },
        "buyingTriggers": { "type": "array", "description": "Events or factors that drive a purchase.", "items": { "type": "string" } },
        "objections": { "type": "array", "description": "Common reasons to hesitate or say no.", "items": { "type": "string" } }
      }
    },

    "swotAnalysis": {
      "type": "object",
      "title": "SWOT Analysis",
      "description": "Internal and external assessment of the business.",
      "additionalProperties": false,
      "required": ["strengths", "weaknesses", "opportunities", "threats", "overallAssessment"],
      "properties": {
        "strengths": { "type": "array", "description": "Internal advantages.", "items": { "type": "string" } },
        "weaknesses": { "type": "array", "description": "Internal limitations to address.", "items": { "type": "string" } },
        "opportunities": { "type": "array", "description": "External chances to grow.", "items": { "type": "string" } },
        "threats": { "type": "array", "description": "External risks to monitor.", "items": { "type": "string" } },
        "overallAssessment": { "type": "string", "description": "One-paragraph takeaway from the analysis." }
      }
    },

    "seoKeywords": {
      "type": "object",
      "title": "SEO Keywords",
      "description": "Keyword strategy with content topic recommendations.",
      "additionalProperties": false,
      "required": ["primaryKeywords", "secondaryKeywords", "longTailKeywords", "contentTopics", "onPageRecommendations"],
      "properties": {
        "primaryKeywords": {
          "type": "array",
          "description": "Highest-priority keywords to target.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "keyword", "intent", "priority"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "keyword": { "type": "string", "description": "The keyword phrase." },
              "intent": { "type": "string", "enum": ["informational", "commercial", "transactional", "navigational"], "description": "Search intent behind the keyword." },
              "volume": { "type": ["string", "null"], "description": "Estimated monthly search volume (e.g. '4.5K')." },
              "difficulty": { "type": ["string", "null"], "description": "Ranking difficulty (e.g. 'Medium')." },
              "priority": { "type": "string", "enum": ["high", "medium", "low"], "description": "Targeting priority." }
            }
          }
        },
        "secondaryKeywords": {
          "type": "array",
          "description": "Supporting keywords.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "keyword", "intent"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "keyword": { "type": "string", "description": "The keyword phrase." },
              "intent": { "type": "string", "enum": ["informational", "commercial", "transactional", "navigational"], "description": "Search intent behind the keyword." }
            }
          }
        },
        "longTailKeywords": {
          "type": "array",
          "description": "Long-tail, low-competition phrases.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "keyword", "intent"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "keyword": { "type": "string", "description": "The keyword phrase." },
              "intent": { "type": "string", "enum": ["informational", "commercial", "transactional", "navigational"], "description": "Search intent behind the keyword." }
            }
          }
        },
        "contentTopics": {
          "type": "array",
          "description": "Content pieces to create around the keywords.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "targetKeyword", "funnelStage"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "title": { "type": "string", "description": "Content title." },
              "targetKeyword": { "type": "string", "description": "Keyword this content targets." },
              "contentType": { "type": "string", "description": "Format (e.g. Blog post, Landing page, Guide)." },
              "funnelStage": { "type": "string", "enum": ["awareness", "consideration", "conversion", "retention"], "description": "Marketing funnel stage." }
            }
          }
        },
        "onPageRecommendations": {
          "type": "array",
          "description": "Technical and on-page SEO suggestions.",
          "items": { "type": "string" }
        }
      }
    },

    "contentCalendar": {
      "type": "object",
      "title": "Content Calendar",
      "description": "Scheduled content plan over a defined period.",
      "additionalProperties": false,
      "required": ["timeframe", "cadence", "schedule"],
      "properties": {
        "timeframe": { "type": "string", "description": "Period covered (e.g. 'Next 30 days')." },
        "cadence": { "type": "string", "description": "Publishing rhythm (e.g. '3 posts / week')." },
        "schedule": {
          "type": "array",
          "description": "Individual content items, renderable as a table.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "date", "channel", "contentFormat", "topic", "cta"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "date": { "type": "string", "format": "date", "description": "Publish date (YYYY-MM-DD)." },
              "channel": { "type": "string", "description": "Platform (e.g. Instagram, Blog)." },
              "contentFormat": { "type": "string", "description": "Format (e.g. Reel, Article, Carousel)." },
              "topic": { "type": "string", "description": "Content topic or working title." },
              "title": { "type": "string", "description": "Optional final title / headline." },
              "cta": { "type": "string", "description": "Call to action for the piece." }
            }
          }
        }
      }
    },

    "advertisementIdeas": {
      "type": "object",
      "title": "Advertisement Ideas",
      "description": "Campaign concepts with copy variants and targeting.",
      "additionalProperties": false,
      "required": ["summary", "campaigns"],
      "properties": {
        "summary": { "type": "string", "description": "Short overview of the ad strategy." },
        "campaigns": {
          "type": "array",
          "description": "Individual campaign ideas.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "platform", "objective", "audience", "budget", "duration", "adCopy", "targetingSuggestions", "expectedOutcome"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "name": { "type": "string", "description": "Campaign name." },
              "platform": { "type": "string", "description": "Ad platform (e.g. Meta Ads, Google Ads)." },
              "objective": { "type": "string", "description": "Campaign objective (e.g. Lead generation)." },
              "audience": { "type": "string", "description": "Who the campaign targets." },
              "budget": { "type": "string", "description": "Budget for the campaign (e.g. '$2,000')." },
              "duration": { "type": "string", "description": "Run time (e.g. '3 weeks')." },
              "adCopy": {
                "type": "array",
                "description": "Copy variants to A/B test.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "headline", "description", "cta"],
                  "properties": {
                    "id": { "type": "string", "description": "Stable unique id for React list keys." },
                    "headline": { "type": "string", "description": "Ad headline." },
                    "description": { "type": "string", "description": "Ad body copy." },
                    "cta": { "type": "string", "description": "Call to action text." }
                  }
                }
              },
              "targetingSuggestions": { "type": "array", "description": "Audience targeting ideas.", "items": { "type": "string" } },
              "expectedOutcome": { "type": "string", "description": "Predicted result (e.g. '3,000 clicks')." }
            }
          }
        }
      }
    },

    "emailCampaign": {
      "type": "object",
      "title": "Email Campaign",
      "description": "Email marketing plan with subject lines and sequence content.",
      "additionalProperties": false,
      "required": ["campaignName", "goal", "audience", "subjectLines", "preheader", "sequence"],
      "properties": {
        "campaignName": { "type": "string", "description": "Name of the email campaign." },
        "goal": { "type": "string", "description": "Campaign objective (e.g. Re-engage lapsed customers)." },
        "audience": { "type": "string", "description": "Segment receiving the emails." },
        "subjectLines": { "type": "array", "description": "Suggested subject line variants.", "items": { "type": "string" } },
        "preheader": { "type": "string", "description": "Preheader text shown after the subject line." },
        "sequence": {
          "type": "array",
          "description": "Emails in order, renderable as a table.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "day", "type", "subject", "previewText", "bodySections", "cta"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "day": { "type": "integer", "minimum": 0, "description": "Day of the sequence (0 = immediate)." },
              "type": { "type": "string", "description": "Email type (e.g. Welcome, Follow-up, Offer)." },
              "subject": { "type": "string", "description": "Email subject line." },
              "previewText": { "type": "string", "description": "Preview text for this email." },
              "bodySections": {
                "type": "array",
                "description": "Content blocks within the email body.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["heading", "content"],
                  "properties": {
                    "heading": { "type": "string", "description": "Section heading." },
                    "content": { "type": "string", "description": "Section body text." }
                  }
                }
              },
              "cta": { "type": "string", "description": "Call to action button text." }
            }
          }
        }
      }
    },

    "competitorAnalysis": {
      "type": "object",
      "title": "Competitor Analysis",
      "description": "Assessment of key competitors and the gaps to exploit.",
      "additionalProperties": false,
      "required": ["competitors", "competitiveAdvantages", "marketGaps", "keyTakeaways"],
      "properties": {
        "competitors": {
          "type": "array",
          "description": "Profiles of each tracked competitor.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "marketPosition", "strengths", "weaknesses", "pricing", "differentiators", "threatLevel"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "name": { "type": "string", "description": "Competitor name." },
              "marketPosition": { "type": "string", "description": "Their position (e.g. 'Premium market leader')." },
              "strengths": { "type": "array", "description": "What they do well.", "items": { "type": "string" } },
              "weaknesses": { "type": "array", "description": "Where they are vulnerable.", "items": { "type": "string" } },
              "pricing": { "type": "string", "description": "Their pricing model or range." },
              "differentiators": { "type": "array", "description": "What sets them apart.", "items": { "type": "string" } },
              "threatLevel": { "type": "string", "enum": ["high", "medium", "low"], "description": "How much of a threat they pose." }
            }
          }
        },
        "competitiveAdvantages": { "type": "array", "description": "Where our business can win.", "items": { "type": "string" } },
        "marketGaps": { "type": "array", "description": "Underserved opportunities in the market.", "items": { "type": "string" } },
        "keyTakeaways": { "type": "array", "description": "Actionable conclusions.", "items": { "type": "string" } }
      }
    },

    "recommendedTools": {
      "type": "object",
      "title": "Recommended Tools",
      "description": "Software stack recommendations to execute the strategy.",
      "additionalProperties": false,
      "required": ["summary", "tools"],
      "properties": {
        "summary": { "type": "string", "description": "Short overview of the recommended stack." },
        "tools": {
          "type": "array",
          "description": "Individual tool recommendations.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "category", "purpose", "pricing", "difficulty", "recommendation"],
            "properties": {
              "id": { "type": "string", "description": "Stable unique id for React list keys." },
              "name": { "type": "string", "description": "Tool name (e.g. Notion, Ahrefs)." },
              "category": {
                "type": "string",
                "enum": ["analytics", "social-media", "seo", "email-marketing", "design", "content", "project-management"],
                "description": "Functional category of the tool."
              },
              "purpose": { "type": "string", "description": "What the tool is used for." },
              "pricing": { "type": "string", "description": "Pricing model (e.g. 'Free', '$99/mo')." },
              "difficulty": { "type": "string", "enum": ["easy", "medium", "advanced"], "description": "Learning curve." },
              "recommendation": { "type": "string", "enum": ["recommended", "optional"], "description": "How strongly it is recommended." }
            }
          }
        }
      }
    }
  }
}
